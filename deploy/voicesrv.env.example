# QmClient Voice Service systemd 环境文件示例
# 安装位置：/etc/qmclient/voicesrv.env
# 权限：chown root:root && chmod 0600
#
# 生成密钥：openssl rand -hex 32

# UDP 语音中继与 HTTP 身份接口的监听地址
BIND_ADDR=0.0.0.0:9987

# 从 machine_hash 派生稳定 QID 的密钥。
# 必须替换为足够长的随机值；更换该值会让所有客户端 QID 变化。
IDENTITY_SECRET=REPLACE_WITH_RANDOM_SECRET

# 可选：日志级别，未设置时默认 info
RUST_LOG=info
